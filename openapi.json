{
  "openapi": "3.0.3",
  "info": { "title": "Traffic-Ops API", "version": "2.0.0", "description": "MERN traffic management API. Bearer sessions expire after 15 minutes. Manual settlement and PayPal Sandbox are separate workflows; only USD synthetic sandbox records are eligible for checkout. Legacy INR records require explicit money migration and staff identity review." },
  "servers": [{ "url": "/api" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health/live": { "get": { "security": [], "summary": "Process liveness", "responses": { "200": { "description": "Live" } } } },
    "/health/ready": { "get": { "security": [], "summary": "Database readiness including ping", "responses": { "200": { "description": "Ready" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/auth/register": { "post": { "security": [], "summary": "Register a pending-verification citizen", "requestBody": { "$ref": "#/components/requestBodies/Account" }, "responses": { "201": { "$ref": "#/components/responses/Session" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/login": { "post": { "security": [], "summary": "Start a short-lived bearer session", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1, "maxLength": 72 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Session" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/me": { "get": { "summary": "Revalidate current user and session", "responses": { "200": { "description": "Safe user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/logout": { "post": { "summary": "Revoke all sessions for this user", "responses": { "204": { "description": "Revoked" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/password": { "patch": { "summary": "Change own password and revoke prior sessions", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["current_password", "new_password"], "properties": { "current_password": { "type": "string", "maxLength": 72 }, "new_password": { "type": "string", "minLength": 10, "maxLength": 72 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Session" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/users": { "post": { "summary": "Admin-only account provisioning", "requestBody": { "$ref": "#/components/requestBodies/Account" }, "responses": { "201": { "description": "Safe user; no password or token returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/auth/citizens": { "get": { "summary": "Officer/admin exact-email citizen lookup", "parameters": [{ "in": "query", "name": "email", "required": true, "schema": { "type": "string", "format": "email", "maxLength": 254 } }], "responses": { "200": { "description": "Zero or one safe citizen", "content": { "application/json": { "schema": { "type": "array", "maxItems": 1, "items": { "$ref": "#/components/schemas/User" } } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/auth/citizens/{id}/verify": { "post": { "summary": "Officer/admin records an independent identity check", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["reference"], "properties": { "reference": { "type": "string", "minLength": 3, "maxLength": 120 } } } } } }, "responses": { "200": { "description": "Verified safe user" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/violations": {
      "get": { "summary": "Scoped, stable descending cursor listing", "description": "Citizens see verified owned v2 records. Officers/admin retain operational access. Cursors bind the actor scope and all filters. Equal timestamps use _id descending. Concurrent new records ahead of a cursor appear after refreshing; this is not a historical snapshot.", "parameters": [{ "in": "query", "name": "limit", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } }, { "in": "query", "name": "cursor", "schema": { "type": "string" } }, { "in": "query", "name": "vehicle_number", "description": "Normalized literal prefix, never a caller regex", "schema": { "type": "string", "maxLength": 20 } }, { "in": "query", "name": "status", "schema": { "type": "string", "enum": ["unpaid", "paid", "disputed"] } }, { "in": "query", "name": "date_from", "description": "Inclusive UTC instant", "schema": { "type": "string", "format": "date-time" } }, { "in": "query", "name": "date_to", "description": "Exclusive UTC instant", "schema": { "type": "string", "format": "date-time" } }], "responses": { "200": { "description": "Bounded result", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Violation" } }, "page": { "type": "object", "required": ["limit", "nextCursor", "hasMore"], "properties": { "limit": { "type": "integer" }, "nextCursor": { "type": "string", "nullable": true }, "hasMore": { "type": "boolean" } } } } } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Officer/admin issues a server-priced violation", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["citizen_id", "vehicle_number", "violation_type", "area"], "properties": { "citizen_id": { "$ref": "#/components/schemas/Id" }, "vehicle_number": { "type": "string", "minLength": 3, "maxLength": 20 }, "violation_type": { "$ref": "#/components/schemas/Id" }, "area": { "$ref": "#/components/schemas/Id" }, "notes": { "type": "string", "maxLength": 2000 } } } } } }, "responses": { "201": { "description": "Authoritative money snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Violation" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/violations/types": { "get": { "summary": "Authoritative fine policies", "responses": { "200": { "description": "Policy array with type_name, amount_minor, currency and policy_version" } } } },
    "/violations/areas": { "get": { "summary": "Available areas", "responses": { "200": { "description": "Area array with _id, area_name and city" } } } },
    "/violations/{id}": { "get": { "summary": "Read an authorized violation", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Violation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Violation" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/violations/{id}/ownership": { "post": { "summary": "Officer/admin reviews an unverified legacy link after money migration", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["citizen_id", "reference"], "properties": { "citizen_id": { "$ref": "#/components/schemas/Id" }, "reference": { "type": "string", "minLength": 3, "maxLength": 120 } } } } } }, "responses": { "200": { "description": "Verified violation with durable IdentityReview" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/violations/{id}/pay": { "put": { "summary": "Officer/admin auditable manual settlement compatibility route", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Idempotency" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["method", "reference", "reason"], "properties": { "method": { "type": "string", "enum": ["cash", "bank_transfer"] }, "reference": { "type": "string", "minLength": 3, "maxLength": 200 }, "reason": { "type": "string", "minLength": 3, "maxLength": 200 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/analytics/dashboard": { "get": { "summary": "Citizen-owned, officer-issued or admin-global totals", "responses": { "200": { "description": "Role-scoped totals by currency", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } } } } },
    "/analytics/stats": { "get": { "summary": "Admin-only global totals; v2 grouped currency contract", "responses": { "200": { "description": "Global dashboard", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/analytics/by-type": { "get": { "summary": "Admin-only counts grouped by violation type", "responses": { "200": { "description": "Array of {_id,type_name,count}" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/payments/config": { "get": { "summary": "Honest sandbox availability", "responses": { "200": { "description": "{available,provider,currencies,reason?}; credentials are never exposed" } } } },
    "/payments/orders": { "post": { "summary": "Reserve one durable collection and create/reuse a sandbox order", "parameters": [{ "$ref": "#/components/parameters/Idempotency" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["violation_id"], "properties": { "violation_id": { "$ref": "#/components/schemas/Id" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Payment" }, "201": { "$ref": "#/components/responses/Payment" }, "202": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/payments/orders/{orderId}/capture": { "post": { "summary": "Verify and capture the server-known order; uncertain outcomes stay reserved", "parameters": [{ "in": "path", "name": "orderId", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{3,80}$" } }, { "$ref": "#/components/parameters/Idempotency" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false } } } }, "responses": { "200": { "$ref": "#/components/responses/Payment" }, "202": { "$ref": "#/components/responses/Payment" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } } },
    "/payments/{id}": { "get": { "summary": "Read own payment/receipt or authorized operational record", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Payment" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/payments/{id}/reconcile": { "post": { "summary": "Read provider state and recover verified local settlement; never initiates capture", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Payment" }, "404": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } } },
    "/payments/webhooks/paypal": { "post": { "security": [], "summary": "Verify original webhook bytes and durably persist a deduplicated inbox", "parameters": [{ "in": "header", "name": "paypal-auth-algo", "required": true, "schema": { "type": "string" } }, { "in": "header", "name": "paypal-cert-url", "required": true, "schema": { "type": "string" } }, { "in": "header", "name": "paypal-transmission-id", "required": true, "schema": { "type": "string" } }, { "in": "header", "name": "paypal-transmission-sig", "required": true, "schema": { "type": "string" } }, { "in": "header", "name": "paypal-transmission-time", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["id", "event_type"], "properties": { "id": { "type": "string" }, "event_type": { "type": "string" }, "resource": { "type": "object" } } } } } }, "responses": { "200": { "description": "Durably accepted, including duplicates" }, "400": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Id": { "in": "path", "name": "id", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "Idempotency": { "in": "header", "name": "Idempotency-Key", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" } }
    },
    "requestBodies": { "Account": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["username", "full_name", "email", "password"], "properties": { "username": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[A-Za-z0-9_]+$" }, "full_name": { "type": "string", "minLength": 1, "maxLength": 100 }, "email": { "type": "string", "format": "email", "maxLength": 254 }, "password": { "type": "string", "minLength": 10, "maxLength": 72 }, "role": { "type": "string", "enum": ["citizen", "officer", "admin"], "description": "Public signup rejects officer/admin. Admin provisioning requires a role." } } } } } } },
    "responses": {
      "Error": { "description": "Sanitized error; requestId also in X-Request-ID", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Session": { "description": "Safe user plus short-lived access token", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/User" }, { "type": "object", "required": ["token"], "properties": { "token": { "type": "string" } } }] } } } },
      "Payment": { "description": "Authoritative payment; receipt only when completed. Manual compatibility route also includes violation.", "content": { "application/json": { "schema": { "type": "object", "required": ["payment", "receipt"], "properties": { "payment": { "$ref": "#/components/schemas/Payment" }, "receipt": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/Receipt" }] }, "violation": { "$ref": "#/components/schemas/Violation" }, "created": { "type": "boolean" } } } } } }
    },
    "schemas": {
      "Id": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
      "User": { "type": "object", "required": ["_id", "username", "full_name", "email", "role", "onboarding_status"], "properties": { "_id": { "$ref": "#/components/schemas/Id" }, "username": { "type": "string" }, "full_name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "role": { "type": "string", "enum": ["citizen", "officer", "admin"] }, "onboarding_status": { "type": "string", "enum": ["pending", "verified"] } } },
      "Error": { "type": "object", "required": ["error", "requestId"], "properties": { "requestId": { "type": "string" }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "code": { "type": "string" } } } } } } } },
      "Violation": { "type": "object", "required": ["_id", "vehicle_number", "owner_name", "status", "amount_minor", "currency"], "properties": { "_id": { "$ref": "#/components/schemas/Id" }, "vehicle_number": { "type": "string" }, "owner_name": { "type": "string" }, "status": { "type": "string", "enum": ["unpaid", "paid", "disputed"] }, "amount_minor": { "type": "integer", "minimum": 1, "maximum": 1000000000000 }, "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "JPY"] }, "fine_amount": { "type": "number", "description": "Legacy INR major units only; omitted for other currencies" }, "schema_version": { "type": "integer" }, "ownership_verified": { "type": "boolean" }, "payment_id": { "type": "string", "nullable": true }, "createdAt": { "type": "string", "format": "date-time" } } },
      "Payment": { "type": "object", "required": ["_id", "violation_id", "amount_minor", "currency", "method", "status", "phase"], "properties": { "_id": { "$ref": "#/components/schemas/Id" }, "violation_id": { "$ref": "#/components/schemas/Id" }, "amount_minor": { "type": "integer" }, "currency": { "type": "string" }, "method": { "type": "string", "enum": ["cash", "bank_transfer", "paypal"] }, "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled"] }, "phase": { "type": "string", "enum": ["order", "approval", "capture", "settled", "review"] }, "provider_order_id": { "type": "string" }, "approval_url": { "type": "string", "format": "uri" } } },
      "Receipt": { "type": "object", "required": ["receipt_id", "violation_id", "amount_minor", "currency", "method", "reference", "actor_id", "settled_at"], "properties": { "receipt_id": { "type": "string" }, "violation_id": { "$ref": "#/components/schemas/Id" }, "amount_minor": { "type": "integer" }, "currency": { "type": "string" }, "method": { "type": "string" }, "reference": { "type": "string" }, "actor_id": { "$ref": "#/components/schemas/Id" }, "settled_at": { "type": "string", "format": "date-time" } } },
      "Dashboard": { "type": "object", "required": ["scope", "counts", "totals"], "properties": { "scope": { "type": "string", "enum": ["citizen-owned", "officer-issued", "global"] }, "counts": { "type": "object", "required": ["total", "paid", "unpaid", "disputed"], "properties": { "total": { "type": "integer" }, "paid": { "type": "integer" }, "unpaid": { "type": "integer" }, "disputed": { "type": "integer" } } }, "totals": { "type": "array", "items": { "type": "object", "required": ["currency", "total_minor", "paid_minor", "unpaid_minor", "disputed_minor"], "properties": { "currency": { "type": "string" }, "total_minor": { "type": "integer" }, "paid_minor": { "type": "integer" }, "unpaid_minor": { "type": "integer" }, "disputed_minor": { "type": "integer" } } } } } }
    }
  }
}
