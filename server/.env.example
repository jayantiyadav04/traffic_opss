# Copy to server/.env and replace placeholders locally. Never commit real values.
MONGO_URI=mongodb://127.0.0.1:27017/traffic_ops_dev?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PUBLIC_BASE_URL=http://localhost:5173
# Seed only a confirmed local disposable database; set all three passwords locally.
SEED_ALLOW_DISPOSABLE=false
SEED_CONFIRM_DATABASE=traffic_ops_dev
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_CITIZEN_PASSWORD=
